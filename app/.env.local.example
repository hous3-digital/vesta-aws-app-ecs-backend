# Vesta LOCAL environment - no Privy, no real contracts, no staging secrets.
# Copy to .env.local (make env). Never paste staging/production values here.
#
# Mode: real ZK (artifacts in ./zk-artifacts) + mocked Stellar (PLACEHOLDER contracts).
# prepare rejects mocked ZK + real contract, but accepts real ZK + mocked Stellar.

NODE_ENV="local"
PORT=3000

# docker compose (app/docker-compose.yml) or a native Postgres with the same user/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vesta_local?schema=public&connect_timeout=300"

# Optional. Without REDIS_URL the challenge falls back to Postgres and the prepare session stays in memory.
REDIS_URL="redis://localhost:6379"

# Stellar MOCKED: PLACEHOLDER + empty secrets => no transaction leaves this machine
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK="Test SDF Network ; September 2015"
VESTA_CONTRACT_ID="PLACEHOLDER"
VESTA_DEPLOYER_SECRET=""
STELLAR_ISSUER_REGISTRY_CONTRACT_ID="PLACEHOLDER"
STELLAR_PAYOUT_CONTRACT_ID="PLACEHOLDER"
STELLAR_PAYOUT_OPERATOR_SECRET=""
STELLAR_PAYOUT_ASSET_CODE="BRL"
STELLAR_PAYOUT_ASSET_DECIMALS="7"

# Real ZK: wasm + zkey + verification_key.json are versioned in app/zk-artifacts
ZK_ARTIFACTS_DIR="./zk-artifacts"
ZK_MOCK_MODE="false"

# Local secrets (min. 32 chars). Fixed on purpose: this environment is disposable.
CPF_HMAC_SECRET="local-only-cpf-hmac-secret-0123456789abcdef"
ADMIN_SECRET="local-only-admin-secret-0123456789abcdefghij"
BACKOFFICE_JWT_SECRET="local-only-backoffice-jwt-secret-0123456789ab"
BACKOFFICE_JWT_EXPIRES_IN="8h"

# Privy OFF: do not set PRIVY_*. The local_bank issuer has privy_enabled=false.

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
WEBAUTHN_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
WEBAUTHN_ALLOWED_RP_IDS="localhost"

COMMISSION_PER_VERIFICATION_BRL="1.37"
COMMISSION_SECURITY_MINUTES="30"
PAYOUT_PROCESSOR_INTERVAL_MS="10000"
COMMISSION_REGISTRATION_PROCESSOR_INTERVAL_MS="10000"
