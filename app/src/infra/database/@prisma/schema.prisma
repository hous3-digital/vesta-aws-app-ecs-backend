generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./dbml"
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
  PENDING
  REJECTED
}

enum CommissionEntryType {
  ACCRUAL
  REVERSAL
}

enum CommissionEntryStatus {
  PENDING_SECURITY
  AVAILABLE
  ALLOCATED
  SETTLED
  REVERSED
}

enum PayoutCycleStatus {
  PREVIEW
}

enum OrganizationWalletStatus {
  PENDING
  ACTIVE
  ERROR
  SUSPENDED
}

model Credential {
  id                String           @unique @map("credential_id")
  nullifier         String?          @unique
  issuer            String?
  kycProvider       String?          @map("kyc_provider")
  kycApproved       Boolean?         @map("kyc_approved")
  issuedAt          DateTime?        @map("issued_at")
  vcHash            String           @unique @map("vc_hash")
  cpfDedupKey       String?          @unique @map("cpf_dedup_key")
  issuerDid         String           @map("issuer_did")
  issuerId          String           @map("issuer_id")
  subjectDid        String           @map("subject_did")
  kycLevel          String           @map("kyc_level")
  status            CredentialStatus @default(ACTIVE)
  sorobanTxHash     String?          @map("soroban_tx_hash")
  userWalletAddress String?          @map("user_wallet_address")
  privyUserId       String?          @map("privy_user_id")
  createdAt         DateTime         @map("created_at")
  updatedAt         DateTime         @map("updated_at")
  expiresAt         DateTime?        @map("expires_at")

  @@index([status])
  @@index([kycProvider])
  @@map("credentials")
}

model PasskeyCredential {
  id               String   @unique @map("passkey_credential_id")
  vcHash           String   @unique @map("vc_hash")
  issuerId         String   @map("issuer_external_id")
  subjectDid       String   @map("subject_did")
  publicKey        String   @map("public_key_base64url")
  counter          Int      @default(0)
  transports       Json?
  deviceType       String   @map("device_type")
  backedUp         Boolean  @default(false) @map("backed_up")
  rpId             String   @map("rp_id")
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@index([issuerId])
  @@index([subjectDid])
  @@map("passkey_credentials")
}

model Attestation {
  id                String   @unique @map("attestation_id")
  vcHash            String   @map("vc_hash")
  proofHash         String   @map("proof_hash")
  verifierId        String   @map("verifier_id")
  kycLevel          String   @map("kyc_level")
  sorobanTxHash     String?  @map("soroban_tx_hash")
  sorobanLedger     Int?     @map("soroban_ledger")
  onChainResult     Boolean  @map("on_chain_result")
  issuerId           String?  @map("issuer_external_id")
  userWalletAddress String?  @map("user_wallet_address")
  createdAt         DateTime @map("created_at")

  @@index([vcHash])
  @@index([issuerId])
  @@map("attestation")
}

model CommissionLedgerEntry {
  id              String                @unique @map("commission_entry_id")
  issuerId        String                @map("issuer_external_id")
  attestationId   String?               @unique @map("attestation_id")
  entryType       CommissionEntryType   @default(ACCRUAL) @map("entry_type")
  status          CommissionEntryStatus @default(PENDING_SECURITY)
  amountMinor     Int                   @map("amount_minor")
  currency        String                @default("BRL")
  source          String                @default("ATTESTATION_REUSE")
  occurredAt      DateTime              @map("occurred_at")
  availableAt     DateTime              @map("available_at")
  payoutCycleId   String?               @map("payout_cycle_id")
  settledAt       DateTime?             @map("settled_at")
  reversalOfId    String?               @map("reversal_of_id")
  createdAt       DateTime              @map("created_at")

  @@index([issuerId, status, availableAt])
  @@index([payoutCycleId])
  @@map("commission_ledger_entries")
}

model PayoutCycle {
  id          String            @unique @map("payout_cycle_id")
  periodStart DateTime          @map("period_start")
  periodEnd   DateTime          @map("period_end")
  cutoffAt    DateTime          @map("cutoff_at")
  status      PayoutCycleStatus @default(PREVIEW)
  createdAt   DateTime          @map("created_at")
  updatedAt   DateTime          @map("updated_at")

  @@unique([periodStart, periodEnd, cutoffAt])
  @@map("payout_cycles")
}

model PayoutCycleItem {
  id             String   @unique @map("payout_cycle_item_id")
  payoutCycleId  String   @map("payout_cycle_id")
  issuerId       String   @map("issuer_external_id")
  amountMinor    Int      @map("amount_minor")
  entriesCount   Int      @map("entries_count")
  entryIds       Json     @map("entry_ids")
  blockedReason  String?  @map("blocked_reason")
  walletAddress  String?  @map("wallet_address")
  createdAt      DateTime @map("created_at")

  @@unique([payoutCycleId, issuerId])
  @@index([issuerId])
  @@map("payout_cycle_items")
}

model OrganizationWallet {
  id               String                   @unique @map("organization_wallet_id")
  issuerId         String                   @unique @map("issuer_external_id")
  privyUserId      String?                  @unique @map("privy_user_id")
  privyWalletId    String?                  @map("privy_wallet_id")
  stellarAddress   String?                  @unique @map("stellar_address")
  network          String                   @map("network")
  status           OrganizationWalletStatus @default(PENDING)
  accountActivated Boolean                  @default(false) @map("account_activated")
  trustlineReady   Boolean                  @default(false) @map("trustline_ready")
  assetCode        String                   @map("asset_code")
  assetIssuer      String?                  @map("asset_issuer")
  lastError        String?                  @map("last_error")
  createdAt        DateTime                 @map("created_at")
  updatedAt        DateTime                 @map("updated_at")

  @@index([status])
  @@map("organization_wallets")
}

model Issuer {
  id           String   @unique @map("issuer_id")
  issuerId     String   @unique @map("issuer_external_id")
  name         String
  status       String   @default("active")
  publicKey    String?  @map("public_key")
  privyEnabled Boolean  @default(false) @map("privy_enabled")
  createdAt    DateTime @map("created_at")

  @@map("issuer")
}

model BackofficeUser {
  id           String   @unique @map("backoffice_user_id")
  issuerId     String   @map("issuer_external_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@index([issuerId])
  @@map("backoffice_users")
}

model Verifier {
  id        String   @unique @map("verifier_id")
  name      String
  status    String   @default("active")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("verifier")
}

model Ingress {
  id        String   @unique @map("ingress_id")
  request   Json
  response  Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("ingress")
}

model Egress {
  id        String   @unique @map("egress_id")
  request   Json
  response  Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("egress")
}

model ApiKey {
  id        String    @unique @map("api_key_id")
  issuerId  String?   @map("issuer_external_id")
  key       String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([issuerId])
  @@index([key, active])
  @@map("api_keys")
}
