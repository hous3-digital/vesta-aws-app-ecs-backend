#!/usr/bin/env sh
# Git runs hooks from the repository root, but the package lives in app/,
# so resolve the message file before changing directory.
msg_file="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

cd "$(git rev-parse --show-toplevel)/app" || exit 1

if [ ! -x ./node_modules/.bin/commitlint ]; then
  echo "husky: commitlint is not installed, skipping check. Run 'yarn install' in app/."
  exit 0
fi

./node_modules/.bin/commitlint --edit "$msg_file"
