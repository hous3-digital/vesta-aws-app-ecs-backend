NODE_ENV="local"

PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vesta-sdk-api?schema=public&connect_timeout=300"

STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK="Test SDF Network ; September 2015"
VESTA_CONTRACT_ID="PLACEHOLDER"
VESTA_DEPLOYER_SECRET=""
ZK_ARTIFACTS_DIR="./zk-artifacts"
ZK_MOCK_MODE="false"

# Minimum 32 chars. Generate with: openssl rand -hex 32
CPF_HMAC_SECRET="change-me-to-a-random-32-plus-char-secret-before-deploy"

PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Valor inicial persistido por reutilizacao elegivel e janela de seguranca
COMMISSION_PER_VERIFICATION_BRL="1.37"
COMMISSION_SECURITY_HOURS="48"

# Ativo unico de liquidacao. Ativo nao nativo requer issuer e trustline.
STELLAR_PAYOUT_ASSET_CODE="BRL"
# STELLAR_PAYOUT_ASSET_ISSUER="G..."

# Segredo usado para assinar JWTs do backoffice.
# Em staging/producao deve ser diferente do ADMIN_SECRET.
BACKOFFICE_JWT_SECRET="change-me-to-a-random-32-plus-char-secret-before-deploy"
